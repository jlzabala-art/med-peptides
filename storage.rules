rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    
    // Knowledge Base Access
    match /knowledge_base/{allPaths=**} {
      allow read, write, list: if request.auth != null;
    }
    
    // Temp Imports
    match /temp_imports/{uid}/{allPaths=**} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }
    
    // Generated PDFs — public read (files are also made public via GCS makePublic())
    match /pdfs/{filename} {
      allow read: if true;
      allow write, delete: if false; // Only writable via Cloud Function (Admin SDK)
    }
    
    // Supplier Quotations (Commercial Invoices & Scanned PDFs)
    match /supplier_quotations/{allPaths=**} {
      allow read, write, list: if request.auth != null;
    }

    // Certificate of Analysis (CoA)
    match /coa/{allPaths=**} {
      allow read, write, list: if request.auth != null;
    }

    // Default fallback (deny unauthenticated access)
    match /{allPaths=**} {
      allow read, write, list: if request.auth != null;
    }
  }
}
