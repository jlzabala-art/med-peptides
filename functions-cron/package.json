{
  "name": "functions-cron",
  "description": "Atlas Health Scheduled Tasks Codebase",
  "dependencies": {
    "@google-analytics/data": "^4.12.1",
    "@google/genai": "^2.7.0",
    "@sparticuz/chromium": "^149.0.0",
    "algoliasearch": "^5.53.0",
    "axios": "^1.17.0",
    "busboy": "^1.6.0",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "googleapis": "^173.0.0",
    "nodemailer": "^8.0.5",
    "pino": "^9.0.0",
    "puppeteer-core": "^25.2.1",
    "string-similarity": "^4.0.4",
    "stripe": "^22.2.0"
  },
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "rm -rf src && cp -R ../functions/src ./src && cp -R ../functions/emailTemplates ./emailTemplates",
    "serve": "npm run build && firebase emulators:start --only functions:cron",
    "deploy": "npm run build && firebase deploy --only functions:cron"
